# Copy this file to .env and fill in locally.
# Never commit .env. The bot process reads these names from the
# environment — it does not print the token.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Numeric chat id. Send /start to the bot and it will tell you.
TELEGRAM_CHAT_ID=

# Optional
DIGEST_TIMEZONE=Europe/Moscow
DIGEST_CRON=30 7 * * *
DIGEST_LOOKBACK_HOURS=24
DIGEST_EXTRA_KEYWORDS=
